# Flask Application
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-secret-key
PORT=7860

# Gemini API (Required for live LLM generation)
# Paper reference value can also be configured here (e.g. gemini-2.5-flash or gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database (App metadata, sessions, query logs, feedback ONLY — never document text)
DATABASE_URL=sqlite:///instance/citizen_assistant.db

# RAG Pipeline Settings (Paper Baseline Defaults)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_MAX=20
HISTORY_WINDOW=6
CHROMA_COLLECTION_PREFIX=citizen_documents

# Improvements & Feature Flags
RETRIEVAL_MODE=hybrid
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_OCR_FALLBACK=true
ENABLE_TABLE_EXTRACTION=true
ENABLE_MULTILINGUAL=true

# Security & Session Limits
SESSION_TTL_MINUTES=60
MAX_CONTENT_LENGTH_MB=25
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_SESSION=10
MAX_PAGES_PER_PDF=100
RATE_LIMIT_PER_MINUTE=30
TESSERACT_CMD=
